# ============================================================
#  Bond — AI Security Analyst : environment configuration
#  Copy to `.env` and fill in. Only ANTHROPIC_API_KEY is required.
#  Every other key is optional: if absent, that tool falls back
#  to a realistic mock so the agent always runs.
# ============================================================

# --- REQUIRED: Claude API (LLM backbone) ---
ANTHROPIC_API_KEY=
# Model used for the reasoning loop (override if desired)
BOND_MODEL=claude-opus-4-8

# --- Agent behavior (optional, sane defaults) ---
# Hard cap on agent reasoning steps before fail-safe escalation
BOND_MAX_STEPS=12

# ============================================================
#  OPTIONAL THREAT-INTEL / SEARCH KEYS (free tiers)
#  Register and paste a key to upgrade that tool from mock -> live.
# ============================================================

# VirusTotal — file/hash/IP/domain/URL reputation
# Free key: https://www.virustotal.com/gui/my-apikey  (4 req/min, 500/day)
VIRUSTOTAL_API_KEY=

# abuse.ch (MalwareBazaar + ThreatFox) — malware hash & IOC lookups
# Free Auth-Key: https://auth.abuse.ch/  (one key works for both services)
ABUSECH_AUTH_KEY=

# AbuseIPDB — IP abuse confidence score
# Free key: https://www.abuseipdb.com/account/api  (1,000 checks/day)
ABUSEIPDB_API_KEY=

# AlienVault OTX — community threat-intel pulses
# Free key: https://otx.alienvault.com/api
OTX_API_KEY=

# Brave Search — optional richer web search (DuckDuckGo used if absent)
# Free key: https://brave.com/search/api/  (2,000 queries/mo)
BRAVE_SEARCH_API_KEY=

# Note: WHOIS, DNS resolution, and IP geolocation (ip-api.com) need NO key.
